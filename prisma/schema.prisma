generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  DUENO
  ADMINISTRACION
  VENDEDOR
  REPARTIDOR
}

model Usuario {
  id            String   @id @default(cuid())
  nombre        String
  usuario       String   @unique
  email         String   @unique
  passwordHash  String
  rol           Rol
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  salidas Salida[]
}

enum TipoCliente {
  MINORISTA
  MAYORISTA
  DISTRIBUIDOR
}

enum CondicionPago {
  CONTADO
  DIAS_7
  DIAS_15
  DIAS_30
  DIAS_45
}

enum ImputacionPago {
  SALDO
  PEDIDO
}

model Zona {
  id     String         @id @default(cuid())
  nombre String         @unique
  orden  Int            @default(0)
  puntos PuntoEntrega[]
}

model Producto {
  id          String           @id @default(cuid())
  nombre      String           @unique
  sku         String?          @unique // código interno, ej. PPT01
  ean         String? // código de barras (opcional)
  descripcion String? // texto para el remito
  unidad      String           @default("paquete") // unidad de venta: "paquete" o "unidad"
  orden       Int              @default(0) // posición en las listas (1, 2, 3…)
  activo      Boolean          @default(true)
  precios     Precio[]
  pedidoItems PedidoItem[]
  especiales  PrecioEspecial[]
}

model ListaPrecios {
  id       String    @id @default(cuid())
  nombre   String    @unique
  activa   Boolean   @default(true)
  orden    Int       @default(0) // posición en los desplegables: Mayorista, Distribuidor y luego las demás
  precios  Precio[]
  clientes Cliente[]
}

// Precio en pesos por PAQUETE, sin IVA.
model Precio {
  listaId    String
  productoId String
  precio     Decimal      @db.Decimal(12, 2)
  lista      ListaPrecios @relation(fields: [listaId], references: [id], onDelete: Cascade)
  producto   Producto     @relation(fields: [productoId], references: [id], onDelete: Cascade)

  @@id([listaId, productoId])
}

model Cliente {
  id                String         @id @default(cuid())
  nombre            String
  tipo              TipoCliente
  razonSocial       String?
  cuit              String?
  observacion       String? // nota importante del cliente (por qué está desactivado, cuidados, etc.)
  facturado         Boolean        @default(false) // true = con factura (IVA); false = con remito
  condicionPago     CondicionPago  @default(CONTADO)
  listaPreciosId    String?
  descuentoPct      Decimal        @default(0) @db.Decimal(5, 2)
  imputacionPago    ImputacionPago @default(SALDO)
  sinLimite         Boolean        @default(false)
  maxPedidosImpagos Int?
  maxMonto          Decimal?       @db.Decimal(14, 2)
  comisionista      String?
  comisionPct       Decimal?       @db.Decimal(5, 2)
  activo            Boolean        @default(true)
  creadoEn          DateTime       @default(now())
  actualizadoEn     DateTime       @updatedAt

  listaPrecios      ListaPrecios?      @relation(fields: [listaPreciosId], references: [id])
  puntos            PuntoEntrega[]
  preciosEspeciales PrecioEspecial[]
  pedidos           Pedido[]
  movimientos       MovimientoCuenta[]
  notasCredito      NotaCredito[]

  @@index([nombre])
}

model PuntoEntrega {
  id         String  @id @default(cuid())
  clienteId  String
  alias      String?
  direccion  String
  barrio     String
  zonaId     String
  telefono   String?
  comentario String?
  activo     Boolean @default(true)

  pedidos Pedido[]
  cliente Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  zona    Zona     @relation(fields: [zonaId], references: [id])

  @@index([clienteId])
  @@index([barrio])
}

// Precio final negociado de un cliente para un producto (por paquete, sin IVA).
// Manda sobre la lista y no lleva descuento encima. Vale para todas las sucursales del cliente.
model PrecioEspecial {
  clienteId  String
  productoId String
  precio     Decimal  @db.Decimal(12, 2)
  cliente    Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  @@id([clienteId, productoId])
}

enum EstadoPedido {
  PENDIENTE // cargado: sin día (bandeja) o con día asignado
  ENTREGADO
  NO_ENTREGADO
  CANCELADO
}

enum TipoMovimiento {
  CARGO_PEDIDO
  AJUSTE_PEDIDO
  ANULACION_PEDIDO
  PAGO
  ANULACION_PAGO
  NOTA_CREDITO
}

enum MedioPago {
  EFECTIVO
  TRANSFERENCIA
  CHEQUE
  MERCADO_PAGO
  OTRO
}

// Qué pasó con el cobro de un pedido entregado: se cobró en el momento, o queda en la cuenta corriente.
enum EstadoCobro {
  COBRADO
  CUENTA_CORRIENTE
}

// Un pedido. Sin fechaEntrega = está en la bandeja "Sin asignar". El número que se ve es su posición en la hoja del día.
model Pedido {
  id              String       @id @default(cuid())
  clienteId       String? // los pedidos de la tienda online (origen WEB) no tienen cliente
  puntoId         String?
  estado          EstadoPedido @default(PENDIENTE)
  fechaEntrega    DateTime?    @db.Date
  ordenDia        Int          @default(0)
  origen          OrigenPedido @default(MAYORISTA)
  salidaId        String? // vehículo del día en el que va (null = todavía sin vehículo)
  ordenRuta       Int          @default(0) // posición dentro del recorrido de ese vehículo
  conFactura      Boolean      @default(false)
  ivaPct          Decimal      @default(0) @db.Decimal(5, 2)
  pagado          Boolean      @default(false)
  numeroFactura   String?
  remitoNumero    Int?         @unique // R-000123: se asigna al emitir el remito y no cambia nunca
  remitoEmitidoEn DateTime?
  cobro           EstadoCobro?
  medioCobro      MedioPago?
  montoCobrado    Decimal?     @db.Decimal(14, 2)
  obsCobro        String? // observación de la cobranza: N° de cheque, de comprobante de transferencia, etc.
  manual          Boolean      @default(false) // factura cargada directamente en CUENTA, sin pedido (el total va en webTotal)
  nota            String?
  autorizadoPorId String?
  creadoPorId     String
  creadoEn        DateTime     @default(now())
  actualizadoEn   DateTime     @updatedAt

  // Pedidos de la tienda online (Empretienda): los datos de entrega viven en el mismo pedido y no pasan por cuenta corriente.
  webOrden     String?   @unique // N° de orden de Empretienda: evita cargar dos veces el mismo pedido
  webNombre    String?
  webDireccion String?
  webBarrio    String?
  webTelefono  String?
  webTotal     Decimal?  @db.Decimal(14, 2) // lo que pagó el cliente en la tienda
  webExtra     Decimal?  @db.Decimal(14, 2) // lo agregado por fuera después del pedido (ya sumado a webTotal)
  webPago      String? // PAGO_MP (ya pagado con Mercado Pago) o PENDIENTE (todavía no se cruzó la transferencia)
  webPagoPor   String? // quién confirmó la transferencia (nombre)
  webPagoEn    DateTime? // cuándo

  cliente        Cliente?                @relation(fields: [clienteId], references: [id])
  punto          PuntoEntrega?           @relation(fields: [puntoId], references: [id])
  salida         Salida?                 @relation(fields: [salidaId], references: [id])
  items          PedidoItem[]
  movimientos    MovimientoCuenta[]
  ncAplicaciones NotaCreditoAplicacion[]
  intentos       IntentoEntrega[]

  @@index([fechaEntrega, ordenDia])
  @@index([clienteId])
  @@index([estado])
  @@index([salidaId])
}

// Renglón del pedido. Guarda una copia del nombre y del precio: un cambio de precio no toca pedidos ya hechos.
model PedidoItem {
  id                String    @id @default(cuid())
  pedidoId          String
  productoId        String? // vacío en los productos de la tienda que no están en el catálogo (ej. el combo)
  nombre            String
  sku               String?
  unidad            String
  paquetesPor       Int       @default(1) // cuántos paquetes ocupa cada unidad (el combo napolitano = 2)
  cantidad          Int
  cantidadEntregada Int?
  precioUnitario    Decimal   @db.Decimal(12, 2) // sin IVA
  sinCargo          Int       @default(0) // paquetes/unidades que se entregan sin cargo (recambios, regalos): no suman al monto
  descuentoPct      Decimal   @default(0) @db.Decimal(5, 2) // bonificación en % sobre el precio de este renglón
  motivoSinCargo    String? // Recambio, Bonificación, Muestra u Otro (obligatorio si hay paquetes sin cargo)
  pedido            Pedido    @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  producto          Producto? @relation(fields: [productoId], references: [id])

  @@index([pedidoId])
}

// Libro de la cuenta corriente: el saldo es la suma de los montos. Nunca se edita, solo se agregan movimientos.
model MovimientoCuenta {
  id        String         @id @default(cuid())
  clienteId String
  pedidoId  String?
  tipo      TipoMovimiento
  monto     Decimal        @db.Decimal(14, 2) // + suma deuda, - la baja
  medio     MedioPago?
  nota      String?
  usuarioId String?
  fecha     DateTime       @default(now())

  cliente Cliente @relation(fields: [clienteId], references: [id])
  pedido  Pedido? @relation(fields: [pedidoId], references: [id])

  @@index([clienteId, fecha])
  @@index([pedidoId])
}

// Día de reparto cerrado: todos sus pedidos tienen entrega y cobro marcados. Un día cerrado es de solo lectura.
model DiaCerrado {
  fecha      DateTime @id @db.Date
  cerradoPor String
  cerradoEn  DateTime @default(now())
}

// Hoja de ruta "lista" (la que se arma el día anterior para salir a la mañana): la estructura queda inamovible —no se mueven pedidos,
// camionetas ni orden— pero se siguen marcando entregas y cobros. Cualquiera de oficina puede volver a abrirla.
model DiaListo {
  fecha    DateTime @id @db.Date
  listoPor String
  listoEn  DateTime @default(now())
}

// Datos de la empresa: salen impresos en el remito (y más adelante en la factura). Hay una sola fila.
model Empresa {
  id                String    @id @default("principal")
  razonSocial       String    @default("")
  nombreComercial   String    @default("BACOLI")
  cuit              String?
  condicionIva      String?
  domicilio         String?
  telefono          String?
  email             String?
  ingresosBrutos    String?
  inicioActividades String?
  puntoVenta        String? // para la factura electrónica, más adelante
  ultimaCopia       DateTime? // la última vez que se descargó una copia de seguridad
  ultimaCopiaPor    String?
}

// Contadores correlativos (por ejemplo "REMITO"). Nunca se retrocede.
model Numerador {
  id     String @id
  ultimo Int    @default(0)
}

// De dónde viene el pedido: lo cargan en la oficina (mayoristas) o entra solo desde la tienda online (minoristas).
enum OrigenPedido {
  MAYORISTA
  WEB
}

// Un vehículo de la empresa (camioneta, auto…). La capacidad máxima la define el dueño, en paquetes (la suma de paquetes y unidades que lleva).
model Vehiculo {
  id        String   @id @default(cuid())
  nombre    String
  patente   String?
  capacidad Int? // paquetes máximos; vacío = sin tope
  activo    Boolean  @default(true)
  eliminado Boolean  @default(false) // "borrado" por el usuario pero con historial: se oculta en todas las listas y no se pierde ninguna hoja de ruta vieja
  orden     Int      @default(0)
  creadoEn  DateTime @default(now())

  salidas Salida[]
}

// Un vehículo que sale un día determinado (con su repartidor). Sus pedidos, ordenados, son el recorrido de esa hoja de ruta.
model Salida {
  id           String   @id @default(cuid())
  fecha        DateTime @db.Date
  vehiculoId   String
  repartidorId String?
  orden        Int      @default(0)
  creadoEn     DateTime @default(now())

  vehiculo   Vehiculo @relation(fields: [vehiculoId], references: [id])
  repartidor Usuario? @relation(fields: [repartidorId], references: [id])
  pedidos    Pedido[]

  @@unique([fecha, vehiculoId])
  @@index([fecha])
}

// Nota de crédito: baja lo que debe el cliente. Puede cubrir varias facturas (o remitos); lo que no se aplica queda como saldo a favor.
// Nunca se edita ni se borra: si estaba mal se anula (anuladaEn) y se carga otra.
model NotaCredito {
  id        String    @id @default(cuid())
  clienteId String
  numero    String? // N° de la NC hecha en ARCA (los ajustes sobre remitos no llevan)
  motivo    String
  monto     Decimal   @db.Decimal(14, 2)
  fecha     DateTime  @default(now())
  usuarioId String?
  anuladaEn DateTime?

  cliente      Cliente                 @relation(fields: [clienteId], references: [id])
  aplicaciones NotaCreditoAplicacion[]

  @@index([clienteId])
}

model NotaCreditoAplicacion {
  id       String  @id @default(cuid())
  notaId   String
  pedidoId String
  monto    Decimal @db.Decimal(14, 2)

  nota   NotaCredito @relation(fields: [notaId], references: [id])
  pedido Pedido      @relation(fields: [pedidoId], references: [id])

  @@index([pedidoId])
  @@index([notaId])
}

// Un pedido que salió en un vehículo y no se pudo entregar. El pedido vuelve a Pedidos para reprogramarlo, y este registro deja
// la "silueta" en la hoja de ruta de ese día (con el motivo, obligatorio). No se edita ni se borra.
model IntentoEntrega {
  id        String   @id @default(cuid())
  pedidoId  String
  fecha     DateTime @db.Date // el día de la hoja de ruta en la que salió
  salidaId  String? // la camioneta de ese día (puede dejar de existir)
  vehiculo  String // nombre de la camioneta, para mostrarlo siempre
  orden     Int // lugar que tenía en el recorrido
  motivo    String
  resumen   Json // lo que se veía en la hoja: barrio, cliente, dirección, teléfono, pedido y monto
  usuarioId String?
  creadoEn  DateTime @default(now())

  pedido Pedido @relation(fields: [pedidoId], references: [id])

  @@index([fecha])
  @@index([pedidoId])
}

// Comprobante emitido en ARCA (facturas y notas de crédito), traído del archivo "Mis Comprobantes Emitidos".
// Por ahora solo se COMPARA con los pedidos (conciliación); no mueve la cuenta corriente.
model ComprobanteArca {
  id            String     @id @default(cuid())
  tipo          Int // código ARCA: 1 Factura A, 3 NC A, 6 Factura B, 8 NC B, 11 Factura C, 13 NC C…
  puntoVenta    Int
  numero        Int
  fecha         DateTime   @db.Date
  cuitReceptor  String? // solo dígitos
  razonSocial   String?
  total         Decimal    @db.Decimal(14, 2)
  cae           String?
  esNotaCredito Boolean    @default(false)
  importadoEn   DateTime   @default(now())
  importadoPor  String?
  puntoId       String? // sucursal a la que va esta factura (la elige una persona; ARCA solo sabe la razón social)
  observacion   String? // dato libre: barrio, aclaración…
  pagado        Boolean    @default(false) // cobrada (la cobranza de las facturas se lleva sobre lo que dice ARCA)
  medioCobro    MedioPago?
  pagadoEn      DateTime?
  obsCobro      String? // N° de cheque, comprobante de transferencia…

  notasAplicadas    AplicacionNcArca[] @relation("NotaDeCredito") // si esta fila es una nota de crédito: a qué facturas se aplicó
  creditosRecibidos AplicacionNcArca[] @relation("FacturaCreditada") // si es una factura: qué notas de crédito la bajan

  @@unique([tipo, puntoVenta, numero])
  @@index([numero])
}

// Una nota de crédito de ARCA aplicada (entera o en parte) a una factura de ARCA. Se anula (se borra la fila) si se aplicó mal.
model AplicacionNcArca {
  id        String   @id @default(cuid())
  ncId      String
  facturaId String
  monto     Decimal  @db.Decimal(14, 2)
  motivo    String? // por qué se emitió la nota de crédito (obligatorio al aplicarla)
  creadoEn  DateTime @default(now())
  creadoPor String?

  nc      ComprobanteArca @relation("NotaDeCredito", fields: [ncId], references: [id], onDelete: Cascade)
  factura ComprobanteArca @relation("FacturaCreditada", fields: [facturaId], references: [id], onDelete: Cascade)

  @@index([ncId])
  @@index([facturaId])
}
