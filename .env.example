# Copiá este archivo como .env y completá los valores. NUNCA subas el .env a GitHub.

# Conexión a la base PostgreSQL (en Railway la completa la propia base)
DATABASE_URL="postgresql://usuario:clave@localhost:5432/bacoli"

# Clave secreta para firmar las sesiones (mínimo 32 caracteres, al azar).
# Generar una con: openssl rand -base64 48
SESSION_SECRET=""

# Datos del primer dueño (solo los usa "npm run db:seed" para crear el primer usuario)
SEED_ADMIN_NOMBRE="Nombre Apellido"
SEED_ADMIN_EMAIL="dueno@ejemplo.com"
SEED_ADMIN_PASSWORD=""

# Solo para emergencias: con SEED_ADMIN_RESET="si" se restablece la contraseña de ese usuario. Borrar después.
# SEED_ADMIN_RESET=""

# Tienda online (Empretienda): enlace CSV de solo lectura de la hoja "Minorista" y primer N° de orden a traer.
EMPRETIENDA_CSV_URL=""
EMPRETIENDA_DESDE=""
